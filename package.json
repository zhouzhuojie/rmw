{
  "name": "rmw",
  "version": "0.1.0",
  "description": "rm watermarks — keep control of AI-generated text; detect and remove invisible Unicode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouzhuojie/rmw.git"
  },
  "bin": {
    "rmw": "packages/cli/dist/cli.js"
  },
  "files": [
    "packages/cli/dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test -w @rmw/core",
    "build": "npm run build -w @rmw/core && npm run build -w @rmw/cli && npm run build -w @rmw/web",
    "dev": "npm run dev -w @rmw/web",
    "preview": "npm run preview -w @rmw/web",
    "rmw": "node packages/cli/dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
